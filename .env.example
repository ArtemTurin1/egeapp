# ============================================
# PlayEx — переменные окружения
# ============================================
# Скопируйте этот файл в .env и заполните значения

# --- База данных PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/app_bd
# Для синхронных миграций (alembic):
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/app_bd

# --- Yandex OAuth (опционально) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://localhost:8000/api/auth/yandex/callback

# --- Telegram бот (опционально) ---
TELEGRAM_BOT_TOKEN=
# Прокси для Telegram (если включен локальный прокси socks5/http или v2ray/xray, например: socks5://127.0.0.1:10808 или http://127.0.0.1:10809)
TELEGRAM_PROXY=

# --- Frontend URL ---
FRONTEND_URL=http://localhost:5173

# --- GitHub Webhook (опционально) ---
GITHUB_SECRET=
DEPLOY_SCRIPT_PATH=

# --- Логирование ---
LOG_LEVEL=INFO
